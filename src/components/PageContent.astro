---
import { getCopy, type Language } from '@/i18n/ui';
import Calculator from './Calculator.astro';
import AgingCurve from './AgingCurve.astro';
import Milestones from './Milestones.astro';

type Props = { lang: Language };

const { lang } = Astro.props;
const c = getCopy(lang);
---

<section class="hero">
  <div class="hero-content">
    <h1>{c.heroTitle}</h1>
    <p class="hero-lead">{c.heroLead}</p>
  </div>
  <svg class="paw" viewBox="0 0 64 64" aria-hidden="true">
    <ellipse cx="17" cy="24" rx="4.8" ry="7.2" transform="rotate(-28 17 24)" />
    <ellipse cx="26" cy="16" rx="5.2" ry="7.8" transform="rotate(-8 26 16)" />
    <ellipse cx="38" cy="16" rx="5.2" ry="7.8" transform="rotate(8 38 16)" />
    <ellipse cx="47" cy="24" rx="4.8" ry="7.2" transform="rotate(28 47 24)" />
    <path
      d="M 32 30 C 38 30, 48 35, 48 42 C 48 48.5, 42.5 53, 37.5 53 C 34.5 53, 33.2 51.5, 32 51.5 C 30.8 51.5, 29.5 53, 26.5 53 C 21.5 53, 16 48.5, 16 42 C 16 35, 26 30, 32 30 Z"
    />
  </svg>
</section>

<Calculator lang={lang} />
<AgingCurve lang={lang} />
<Milestones lang={lang} />

<section class="how-section" aria-labelledby="how-heading">
  <h2 id="how-heading">{c.howHeading}</h2>
  <div class="formula-box" tabindex="0" role="region" aria-label={c.formulaText}>
    <code class="formula">{c.formulaText}</code>
  </div>

  {c.methodParagraphs.map((paragraph) => <p class="method-p">{paragraph}</p>)}
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 2.25rem 1.75rem;
    padding-inline: 1.25rem;
    margin-inline: -1.25rem;
    background: linear-gradient(135deg, var(--accent-soft), transparent 70%);
    border-radius: 0 0 1.5rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 44rem;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .hero-lead {
    font-size: 1.1rem;
    line-height: 1.55;
    margin: 0;
    color: var(--fg);
    opacity: 0.95;
  }

  .paw {
    position: absolute;
    right: 1rem;
    top: 1rem;
    width: 64px;
    height: 64px;
    fill: var(--accent);
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }

  @media (min-width: 640px) {
    .paw {
      right: 1.5rem;
      top: 1.5rem;
      width: 90px;
      height: 90px;
      opacity: 0.15;
    }
  }

  .how-section {
    margin-block: 3rem 1.5rem;
  }

  .formula-box {
    margin-block: 1rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.25rem;
  }

  .formula {
    display: inline-block;
    font-size: 1.15rem;
    font-weight: 700;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: var(--card);
    box-shadow: 0 2px 10px rgb(61 44 30 / 0.05);
    padding: 0.4rem 0.85rem;
    white-space: nowrap;
  }

  .method-p {
    line-height: 1.7;
    margin-bottom: 1rem;
  }
</style>
