---
import { getCopy, type Language } from '@/i18n/ui';
import Calculator from './Calculator.astro';
import AgingCurve from './AgingCurve.astro';
import Milestones from './Milestones.astro';

type Props = { lang: Language };

const { lang } = Astro.props;
const c = getCopy(lang);
---

<section class="hero">
  <div class="hero-content">
    <h1>{c.heroTitle}</h1>
    <p class="hero-lead">{c.heroLead}</p>
  </div>
  <svg class="paw" viewBox="0 0 64 64" aria-hidden="true">
    <ellipse cx="21" cy="17" rx="6.5" ry="8.5" transform="rotate(-15 21 17)" />
    <ellipse cx="35" cy="13" rx="6.5" ry="8.5" />
    <ellipse cx="47" cy="19" rx="6.5" ry="8.5" transform="rotate(15 47 19)" />
    <ellipse cx="54" cy="33" rx="5.5" ry="7.5" transform="rotate(38 54 33)" />
    <path
      d="M32 27c9.5 0 18 7.5 18 16 0 7-5.2 11-11 11-3 0-4.4-1.2-7-1.2S28.9 54 26 54c-5.8 0-11-4-11-11 0-8.5 8.5-16 17-16z"
    />
  </svg>
</section>

<Calculator lang={lang} />
<AgingCurve lang={lang} />
<Milestones lang={lang} />

<section class="how-section" aria-labelledby="how-heading">
  <h2 id="how-heading">{c.howHeading}</h2>
  <div class="formula-box" tabindex="0" role="region" aria-label={c.formulaText}>
    <code class="formula">{c.formulaText}</code>
  </div>

  {c.methodParagraphs.map((paragraph) => <p class="method-p">{paragraph}</p>)}
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 2.25rem 1.75rem;
    padding-inline: 1.25rem;
    margin-inline: -1.25rem;
    background: linear-gradient(135deg, var(--accent-soft), transparent 70%);
    border-radius: 0 0 1.5rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 44rem;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .hero-lead {
    font-size: 1.1rem;
    line-height: 1.55;
    margin: 0;
    color: var(--fg);
    opacity: 0.95;
  }

  .paw {
    position: absolute;
    right: 1rem;
    top: 1rem;
    width: 64px;
    height: 64px;
    fill: var(--accent);
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }

  @media (min-width: 640px) {
    .paw {
      right: 1.5rem;
      top: 1.5rem;
      width: 90px;
      height: 90px;
      opacity: 0.15;
    }
  }

  .how-section {
    margin-block: 3rem 1.5rem;
  }

  .formula-box {
    margin-block: 1rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.25rem;
  }

  .formula {
    display: inline-block;
    font-size: 1.15rem;
    font-weight: 700;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: var(--card);
    box-shadow: 0 2px 10px rgb(61 44 30 / 0.05);
    padding: 0.4rem 0.85rem;
    white-space: nowrap;
  }

  .method-p {
    line-height: 1.7;
    margin-bottom: 1rem;
  }
</style>
