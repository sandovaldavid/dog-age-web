---
import { getCopy, type Language } from '@/i18n/ui';
import Calculator from './Calculator.astro';
import Milestones from './Milestones.astro';

type Props = { lang: Language };

const { lang } = Astro.props;
const c = getCopy(lang);
---

<section class="hero">
  <svg class="paw" viewBox="0 0 64 64" aria-hidden="true">
    <ellipse cx="21" cy="17" rx="6.5" ry="8.5" transform="rotate(-15 21 17)" />
    <ellipse cx="35" cy="13" rx="6.5" ry="8.5" />
    <ellipse cx="47" cy="19" rx="6.5" ry="8.5" transform="rotate(15 47 19)" />
    <ellipse cx="54" cy="33" rx="5.5" ry="7.5" transform="rotate(38 54 33)" />
    <path
      d="M32 27c9.5 0 18 7.5 18 16 0 7-5.2 11-11 11-3 0-4.4-1.2-7-1.2S28.9 54 26 54c-5.8 0-11-4-11-11 0-8.5 8.5-16 17-16z"
    />
  </svg>
  <h1>{c.heroTitle}</h1>
  <p class="hero-lead">{c.heroLead}</p>
</section>
<Calculator lang={lang} />
<Milestones lang={lang} />
<section aria-labelledby="how-heading">
  <h2 id="how-heading">{c.howHeading}</h2>
  <p><code class="formula">{c.formulaText}</code></p>
  {c.methodParagraphs.map((paragraph) => <p>{paragraph}</p>)}
</section>

<style>
  .hero {
    position: relative;
    padding-block: 3rem 2rem;
    padding-inline: 1.25rem;
    margin-inline: -1.25rem;
    background: linear-gradient(135deg, var(--accent-soft), transparent 60%);
    border-radius: 0 0 2rem 2rem;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 3rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .hero-lead {
    font-size: 1.125rem;
    max-width: 42rem;
  }

  .paw {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 120px;
    height: 120px;
    fill: var(--accent);
    opacity: 0.15;
    pointer-events: none;
  }

  .formula {
    display: inline-block;
    font-size: 1.15rem;
    font-weight: bold;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--card);
    box-shadow: 0 2px 10px rgb(61 44 30 / 0.06);
    padding: 0.25rem 0.6rem;
  }
</style>
