---
import { getCopy, languages, type Language } from '@/i18n/ui';

type Props = { lang: Language };

const { lang } = Astro.props;
const c = getCopy(lang);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const pathFor = (l: Language) => (l === 'en' ? `${base}/` : `${base}/es/`);
const other: Language = lang === 'en' ? 'es' : 'en';
const doiUrl = 'https://doi.org/10.1016/j.cels.2020.06.006';

const canonicalUrl = new URL(pathFor(lang), Astro.site);
const defaultUrl = new URL(pathFor('en'), Astro.site);
const alternateEn = new URL(pathFor('en'), Astro.site);
const alternateEs = new URL(pathFor('es'), Astro.site);
const ogImageUrl = new URL(`${base}/docs/screenshot-light.png`, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: c.siteName,
  description: c.metaDescription,
  url: canonicalUrl.toString(),
  inLanguage: c.htmlLang,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: c.authorName,
    url: c.authorUrl,
  },
  citation: {
    '@type': 'ScholarlyArticle',
    name: 'Quantitative Translation of Dog-to-Human Aging by Conserved Remodeling of the DNA Methylome',
    sameAs: doiUrl,
  },
};
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.metaTitle}</title>
    <meta name="description" content={c.metaDescription} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fff8f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#201612" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.metaTitle} />
    <meta property="og:description" content={c.metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.metaTitle} />
    <meta name="twitter:description" content={c.metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={pathFor(lang)}>{c.siteName}</a>
      <nav aria-label={c.langToggleLabel}>
        <a class="lang-link" href={pathFor(other)} hreflang={other} lang={other}>
          {languages[other]}
        </a>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <section class="citation-block" aria-labelledby="citation-heading">
          <h2 id="citation-heading">{c.citationTitle}</h2>
          <p class="citation-text">{c.citation}</p>
          <p class="citation-link">
            <a href={doiUrl} target="_blank" rel="noopener noreferrer">{c.citationDoiLabel}</a>
          </p>
        </section>

        <div class="footer-divider"></div>

        <section class="footer-meta" aria-label="Credits and disclaimer">
          <p class="credit-author">
            {c.authorBy} <a href={c.authorUrl} target="_blank" rel="noopener noreferrer"><strong>{c.authorName}</strong></a> &bull;
            <a href={c.repoUrl} target="_blank" rel="noopener noreferrer">{c.repoLabel}</a>
          </p>
          <p class="credit-source">{c.creditLine}</p>
          <p class="disclaimer">{c.disclaimer}</p>
        </section>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fff8f2;
    --card: #ffffff;
    --fg: #3d2c1e;
    --muted: #7a604d;
    --accent: #ea580c;
    --accent-text: #c2410c;
    --accent-contrast: #ffffff;
    --accent-soft: #ffedd5;
    --border: #f0dfce;
    --warn-bg: #fef3c7;
    --warn-fg: #92400e;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #201612;
      --card: #2b1e17;
      --fg: #f5ebdd;
      --muted: #b99c86;
      --accent: #fb923c;
      --accent-text: #fdba74;
      --accent-contrast: #201612;
      --accent-soft: #38251a;
      --border: #40302a;
      --warn-bg: #452f0b;
      --warn-fg: #fde68a;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    line-height: 1.65;
    color: var(--fg);
    background: var(--bg);
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .container {
    max-width: 56rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: 1.25rem;
    flex: 1;
  }

  a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: 56rem;
    width: 100%;
    margin-inline: auto;
    padding: 1rem 1.25rem;
  }

  .site-name {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--fg);
    text-decoration: none;
    line-height: 1.3;
  }

  .site-name:hover {
    color: var(--accent);
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.4rem 1rem;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    transition: filter 150ms ease;
    white-space: nowrap;
  }

  .lang-link:hover {
    filter: brightness(1.06);
  }

  .site-footer {
    width: 100%;
    margin-top: 3.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .site-footer a {
    color: var(--accent-text);
  }

  .footer-inner {
    max-width: 56rem;
    margin-inline: auto;
    padding: 2.5rem 1.25rem 3.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .citation-block h2 {
    font-size: 1.05rem;
    color: var(--fg);
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .citation-text {
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .citation-link {
    margin-top: 0.25rem;
  }

  .footer-divider {
    height: 1px;
    background: var(--border);
    margin-block: 1.75rem;
    opacity: 0.7;
  }

  .credit-author {
    color: var(--fg);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .credit-source {
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .disclaimer {
    color: var(--fg);
    opacity: 0.88;
    font-size: 0.85rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

</style>
