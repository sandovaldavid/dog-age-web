---
import { getCopy, languages, type Language } from '@/i18n/ui';

type Props = { lang: Language };

const { lang } = Astro.props;
const c = getCopy(lang);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const pathFor = (l: Language) => (l === 'en' ? `${base}/` : `${base}/es/`);
const other: Language = lang === 'en' ? 'es' : 'en';
const doiUrl = 'https://doi.org/10.1016/j.cels.2020.06.006';
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.metaTitle}</title>
    <meta name="description" content={c.metaDescription} />
    <link rel="canonical" href={new URL(pathFor(lang), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(pathFor('en'), Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(pathFor('es'), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.metaTitle} />
    <meta property="og:description" content={c.metaDescription} />
    <meta property="og:url" content={new URL(pathFor(lang), Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <p class="site-name">{c.siteName}</p>
      <nav aria-label={c.langToggleLabel}>
        <a class="lang-link" href={pathFor(other)}>{languages[other]}</a>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <section aria-labelledby="citation-heading">
        <h2 id="citation-heading">{c.citationTitle}</h2>
        <p>{c.citation}</p>
        <p><a href={doiUrl}>{c.citationDoiLabel}</a></p>
      </section>
      <p class="credit">{c.creditLine}</p>
      <p class="disclaimer">{c.disclaimer}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fff8f2;
    --card: #ffffff;
    --fg: #3d2c1e;
    --muted: #8a6f5c;
    --accent: #ea580c;
    --accent-contrast: #ffffff;
    --accent-soft: #ffedd5;
    --border: #f0dfce;
    --warn-bg: #fef3c7;
    --warn-fg: #92400e;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #201612;
      --card: #2b1e17;
      --fg: #f5ebdd;
      --muted: #b99c86;
      --accent: #fb923c;
      --accent-contrast: #201612;
      --accent-soft: #38251a;
      --border: #40302a;
      --warn-bg: #452f0b;
      --warn-fg: #fde68a;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    line-height: 1.65;
    color: var(--fg);
    background: var(--bg);
    margin: 0;
  }

  .container {
    max-width: 56rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  a {
    color: var(--accent);
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: 56rem;
    margin-inline: auto;
    padding: 1rem 1.25rem;
  }

  .site-name {
    margin: 0;
    font-weight: bold;
  }

  .lang-link {
    display: inline-block;
    min-height: 44px;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
    border: none;
    border-radius: 999px;
    text-decoration: none;
  }

  .lang-link:hover {
    filter: brightness(1.05);
  }

  .site-footer {
    max-width: 56rem;
    margin-inline: auto;
    padding: 2rem 1.25rem 3rem;
    color: var(--muted);
    font-size: 0.875rem;
    border-top: 1px solid var(--border);
    margin-top: 3rem;
  }

  .site-footer h2 {
    font-size: 1rem;
  }

  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--card);
  }

  thead th {
    background: var(--accent-soft);
  }

  tbody th[scope='row'] {
    font-weight: 400;
    color: var(--muted);
  }

  tbody td {
    font-weight: 700;
    color: var(--accent);
  }

  tbody tr:hover {
    background: color-mix(in srgb, var(--accent-soft) 50%, transparent);
  }

  th,
  td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
</style>
